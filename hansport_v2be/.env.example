# Han Sports v2 backend environment template.
# Copy this file to .env for local development and replace placeholders.
# Never commit a real .env file.

DB_URL=jdbc:mysql://localhost:3306/hansport_v2?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
SECURITY_LOG_LEVEL=INFO

JWT_BASE64_SECRET=<base64_jwt_signing_key>
JWT_ACCESS_TOKEN_VALIDITY=86400
JWT_REFRESH_TOKEN_VALIDITY=604800

UPLOAD_FILE_BASE_PATH=../hansport_v2fe/upload

GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>

YOUR_EMAIL=<gmail_address>
YOUR_APP_PASSWORD=<app-pw>

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_LOCALHOST=true
COOKIE_SECURE=false
SEED_ENABLED=true
SEED_REQUIRED_ENABLED=true
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PASSWORD=<local_admin_password>
SEED_SETTINGS_ENABLED=true
MANAGEMENT_ENDPOINTS=health,info
