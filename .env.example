# Docker Compose environment template for Han Sports v2.
# Copy to .env for local Docker runs. Never commit real secrets.

DB_PASSWORD=<db_password>
MYSQL_ROOT_PASSWORD=<mysql_root_password>
MYSQL_HOST_PORT=3307
JWT_BASE64_SECRET=<base64_jwt_signing_key>

GOOGLE_CLIENT_ID=unused-local-client
GOOGLE_CLIENT_SECRET=unused-local-secret
YOUR_EMAIL=noreply@example.invalid
YOUR_APP_PASSWORD=unused-local-password
VITE_GOOGLE_CLIENT_ID=

MANAGEMENT_HEALTH_MAIL_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false
SEED_ENABLED=false
SEED_REQUIRED_ENABLED=true
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_SETTINGS_ENABLED=false
